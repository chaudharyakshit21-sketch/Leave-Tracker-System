<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Backdated_Leave_Except_Sick</fullName>
    <active>true</active>
    <description>Only Sick leave can be backdated.</description>
    <errorConditionFormula>AND(ISNEW(), Start_Date__c &lt; TODAY(), NOT(ISPICKVAL(Leave_Type__c, "Sick")))</errorConditionFormula>
    <errorDisplayField>Start_Date__c</errorDisplayField>
    <errorMessage>Only Sick leave can be backdated.</errorMessage>
</ValidationRule>
